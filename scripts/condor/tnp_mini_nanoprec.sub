# 40 jobs, as tnp_mini.sub but with electron and trigger-object eta/phi rounded to the NanoAOD stored precision.
# Submit from the same AFS directory as tnp_mini.sub: condor_submit tnp_mini_nanoprec.sub
executable            = tnp_mini_job.sh
arguments             = $(INDEX) $(LFN) nanoprec
output                = logs/job_$(INDEX)_nanoprec.out
error                 = logs/job_$(INDEX)_nanoprec.err
log                   = logs/condor_nanoprec.log
use_x509userproxy     = true
x509userproxy         = /afs/cern.ch/user/s/smahata/private/x509up_cms
request_cpus          = 1
+JobFlavour           = "longlunch"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = tnp_$(INDEX)_mini_nanoprec.json
# the queue variable must not be called INPUT: submit commands are case-insensitive and "input" is the stdin file
queue INDEX, LFN from inputs.txt
