# 40 jobs, MINIAOD tag-and-probe reference on the same 40 MINIAOD parents as tnp.sub (inputs.txt).
# Submit from an AFS directory that holds tnp_mini_job.sh, tnp_mini.sub and inputs.txt: condor_submit tnp_mini.sub
executable            = tnp_mini_job.sh
arguments             = $(INDEX) $(LFN)
output                = logs/job_$(INDEX).out
error                 = logs/job_$(INDEX).err
log                   = logs/condor.log
use_x509userproxy     = true
x509userproxy         = /afs/cern.ch/user/s/smahata/private/x509up_cms
request_cpus          = 1
+JobFlavour           = "longlunch"
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = tnp_$(INDEX)_mini.json
# the queue variable must not be called INPUT: submit commands are case-insensitive and "input" is the stdin file
queue INDEX, LFN from inputs.txt
